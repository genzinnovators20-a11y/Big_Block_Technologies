# ---------------------------------------------------------------------------
# Big Block Technologies — frontend environment
#
# Everything prefixed with VITE_ is inlined into the client bundle at build
# time and is therefore PUBLIC. Never place API keys, database credentials or
# any other secret in this file. Secrets belong in the backend service only.
# ---------------------------------------------------------------------------

# Absolute site origin, no trailing slash. Used for canonical URLs, Open Graph
# tags and the sitemap. Must match the domain the site is actually served from.
VITE_SITE_URL=https://www.bigblocktechnologies.com

# Public contact details rendered in the UI. Leave blank to hide the row.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_LOCATION=

# Public social profiles. Leave blank to hide the link.
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_X=

# Base URL of the backend API (contact form, careers applications, assistant).
# Leave blank while no backend is deployed: the UI then runs in a clearly
# signalled "not connected" mode instead of faking a successful submission.
VITE_API_BASE_URL=
